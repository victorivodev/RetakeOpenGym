{
  "appId": "br.com.retaketecnologia.gym",
  "appName": "Retake Gym",
  "webDir": "dist",
  "backgroundColor": "#0c1324",
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 8000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#0c1324",
      "showSpinner": false
    }
  }
}
